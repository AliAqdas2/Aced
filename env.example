# Aced environment configuration
#
# Copy this file to .env (or configure the same variables in your hosting
# provider). Never commit .env or real credentials.
#
# The API server reads these variables at runtime. If you run the web and API
# as separate services, configure the API variables on the API service and
# configure BASE_PATH/PORT on the web service as appropriate.

# -----------------------------------------------------------------------------
# Required runtime settings
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=8080

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Long, random value used to sign session cookies and encrypt sensitive values.
# Generate a new value for each environment; do not reuse the development value.
SESSION_SECRET=replace-with-a-long-random-secret

# Public canonical URL used in email links, OAuth callbacks, and Stripe return
# URLs. Include the scheme and do not add a trailing slash.
APP_URL=https://your-domain.example

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=https://your-domain.example

# -----------------------------------------------------------------------------
# Payments: Stripe Connect and Checkout
# -----------------------------------------------------------------------------

# Use live keys only in production. Keep these in your hosting provider's
# secret manager rather than committing them.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Configure Stripe's webhook endpoint as:
#   https://your-domain.example/api/v1/webhooks/stripe
# Required events and Connect settings are documented in the application code.

# -----------------------------------------------------------------------------
# Transactional email
# -----------------------------------------------------------------------------

# Sender shown on verification, password-reset, application, booking, and
# payment emails. The sending transport must also be configured below or
# replaced in artifacts/api-server/src/lib/email.ts.
EMAIL_FROM=Aced <noreply@your-domain.example>

# The current Replit deployment sends production email through the installed
# Replit Resend connector. RESEND_API_KEY is NOT read by the current code.
#
# When porting outside Replit, replace the connector call in email.ts with
# Resend/SMTP/another provider and add that provider's credentials to the
# server environment. Do not put those credentials in this file.

# -----------------------------------------------------------------------------
# Calendar integrations (optional)
# -----------------------------------------------------------------------------

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Calendar OAuth
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Register callbacks at:
#   ${APP_URL}/api/v1/auth/google/calendar/callback
#   ${APP_URL}/api/v1/auth/microsoft/calendar/callback

# -----------------------------------------------------------------------------
# Object storage (required for profile photos, banners, and uploaded files)
# -----------------------------------------------------------------------------

# These are the variables used by the current Replit Object Storage
# implementation. They are Replit-managed object paths, not ordinary
# S3/GCS credentials.
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# IMPORTANT FOR PORTING:
# artifacts/api-server/src/lib/objectStorage.ts currently authenticates through
# the Replit sidecar at 127.0.0.1:1106. The variables above alone will not make
# uploads work on another server. Replace that client with your S3/GCS
# provider's SDK and configure that provider's credentials through its secret
# manager. Also preserve the /api/storage/objects/* serving paths or migrate
# stored object URLs.

# -----------------------------------------------------------------------------
# Optional logging and local development settings
# -----------------------------------------------------------------------------

LOG_LEVEL=info

# Used by the Vite development proxy, Playwright, and local multi-service
# workflows. Not normally needed by a single production API process.
API_PORT=8080
WEB_PORT=24285
BASE_PATH=/

# -----------------------------------------------------------------------------
# Replit-only variables (do not copy these to a non-Replit host unless needed)
# -----------------------------------------------------------------------------

# REPLIT_DOMAINS=
# REPLIT_DEV_DOMAIN=
# REPLIT_INTERNAL_APP_DOMAIN=
# REPL_ID=
# EXPO_PUBLIC_DOMAIN=
# EXPO_PUBLIC_REPL_ID=
