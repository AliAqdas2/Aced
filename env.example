# Aced environment configuration
#
# Copy this file to .env (or configure the same variables in your hosting
# provider). Never commit .env or real credentials.
#
# Production (Docker): single container serves API + web on PORT (default 8080).
# Caddy (or another reverse proxy) terminates TLS and forwards to the container.

# -----------------------------------------------------------------------------
# Required runtime settings
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# PostgreSQL connection string.
# Local:  createdb aced  then use localhost
# Docker: use the postgres service hostname on infra_internal, e.g. postgres:5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aced

# Optional: force SSL on/off for PostgreSQL (auto-detected for localhost/postgres/private IPs).
# DATABASE_SSL=false

# Database migrations (Docker tools image — pull :tools first):
# Existing DB (tables already present): mark init migration as applied
#   docker compose --profile tools run --rm db-baseline
# Empty DB (first install):
#   docker compose --profile tools run --rm db-migrate
# Manual SQL: lib/db/drizzle/0000_init.sql

# Long, random value used to sign session cookies and encrypt sensitive values.
# Generate a new value for each environment; do not reuse the development value.
SESSION_SECRET=dev-session-secret-change-me

# Public canonical URL used in email links, OAuth callbacks, and Stripe return
# URLs. Include the scheme and do not add a trailing slash.
APP_URL=http://localhost:8080

# Comma-separated browser origins allowed to call the API with credentials.
# Production Docker example: CORS_ORIGINS=https://your-domain.example
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:24285

# -----------------------------------------------------------------------------
# Payments: Stripe Connect and Checkout
# -----------------------------------------------------------------------------

# Use live keys only in production. Keep these in your hosting provider's
# secret manager rather than committing them.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Configure Stripe's webhook endpoint as:
#   https://your-domain.example/api/v1/webhooks/stripe
# Required events and Connect settings are documented in the application code.

# -----------------------------------------------------------------------------
# Transactional email (Resend)
# -----------------------------------------------------------------------------

# Sender shown on verification, password-reset, application, booking, and
# payment emails.
EMAIL_FROM=Aced <noreply@your-domain.example>

# Resend API key — required in production for sending email.
# https://resend.com/api-keys
RESEND_API_KEY=re_replace_me

# -----------------------------------------------------------------------------
# Calendar integrations (optional)
# -----------------------------------------------------------------------------

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Calendar OAuth
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Register callbacks at:
#   ${APP_URL}/api/v1/auth/google/calendar/callback
#   ${APP_URL}/api/v1/auth/microsoft/calendar/callback

# Object storage — files are stored on disk under ./storage/ at the repo root.
# In Docker, mount a volume at /app/storage (see docker-compose.yml).
# No external cloud credentials are required.

# -----------------------------------------------------------------------------
# Docker production example (copy to server .env, adjust values)
# -----------------------------------------------------------------------------
#
# NODE_ENV=production
# PORT=8080
# DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/aced
# SESSION_SECRET=replace-with-a-long-random-secret
# APP_URL=https://your-domain.example
# CORS_ORIGINS=https://your-domain.example
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# EMAIL_FROM=Aced <noreply@your-domain.example>
# RESEND_API_KEY=re_...
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# One-shot admin bootstrap (not used by the running app)
# -----------------------------------------------------------------------------
#
# Requires ghcr.io/aliaqdas2/aced-portal:tools (not :latest):
#   docker compose --profile tools pull
#   docker compose --profile tools run --rm bootstrap-admins
# Creates or promotes chan.vekaria@slimsumo.co.uk and jaikiranvekaria@gmail.com
# to admin with password password123 (default).
#
# ADMIN_BOOTSTRAP_PASSWORD=password123
# ADMIN_CHAN_PASSWORD=
# ADMIN_JAIKIRAN_PASSWORD=

# -----------------------------------------------------------------------------
# Optional logging and local development settings
# -----------------------------------------------------------------------------

LOG_LEVEL=info

# Used by the Vite dev server and Playwright only — not needed in Docker production.
API_PORT=8080
WEB_PORT=24285
BASE_PATH=/

# Mobile (Expo) public domain for static builds
# EXPO_PUBLIC_DOMAIN=your-domain.example
