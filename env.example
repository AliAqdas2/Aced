# Aced environment configuration
#
# Copy this file to .env (or configure the same variables in your hosting
# provider). Never commit .env or real credentials.
#
# The API server reads these variables at runtime. If you run the web and API
# as separate services, configure the API variables on the API service and
# configure BASE_PATH/PORT on the web service as appropriate.

# -----------------------------------------------------------------------------
# Required runtime settings
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=8080

# Local PostgreSQL connection string.
# Create the database first:  createdb aced
# Default Homebrew/Postgres.app user is often your macOS username with no password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aced

# Long, random value used to sign session cookies and encrypt sensitive values.
# Generate a new value for each environment; do not reuse the development value.
SESSION_SECRET=dev-session-secret-change-me

# Public canonical URL used in email links, OAuth callbacks, and Stripe return
# URLs. Include the scheme and do not add a trailing slash.
APP_URL=http://localhost:8080

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:24285

# -----------------------------------------------------------------------------
# Payments: Stripe Connect and Checkout
# -----------------------------------------------------------------------------

# Use live keys only in production. Keep these in your hosting provider's
# secret manager rather than committing them.
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Configure Stripe's webhook endpoint as:
#   https://your-domain.example/api/v1/webhooks/stripe
# Required events and Connect settings are documented in the application code.

# -----------------------------------------------------------------------------
# Transactional email (Resend)
# -----------------------------------------------------------------------------

# Sender shown on verification, password-reset, application, booking, and
# payment emails.
EMAIL_FROM=Aced <noreply@your-domain.example>

# Resend API key — required in production for sending email.
# https://resend.com/api-keys
RESEND_API_KEY=re_replace_me

# -----------------------------------------------------------------------------
# Calendar integrations (optional)
# -----------------------------------------------------------------------------

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Calendar OAuth
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

# Register callbacks at:
#   ${APP_URL}/api/v1/auth/google/calendar/callback
#   ${APP_URL}/api/v1/auth/microsoft/calendar/callback

# Object storage — files are stored on disk under ./storage/ at the repo root.
# No external cloud credentials are required.
# Uploaded content is gitignored; the empty directory is kept via storage/.gitkeep.

# -----------------------------------------------------------------------------
# Optional logging and local development settings
# -----------------------------------------------------------------------------

LOG_LEVEL=info

# Used by the Vite development proxy, Playwright, and local multi-service
# workflows. Not normally needed by a single production API process.
API_PORT=8080
WEB_PORT=24285
BASE_PATH=/

# Mobile (Expo) public domain for static builds
# EXPO_PUBLIC_DOMAIN=your-domain.example
